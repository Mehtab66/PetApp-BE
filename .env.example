NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/petcare

JWT_SECRET=your-jwt-secret
JWT_EXPIRE=7d

ALLOWED_ORIGINS=*
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Amazon Creators API (server-side only — never put these in the React Native app)
# Get Credential ID, Secret, and Version from Amazon Associates Central.
CREATORS_CREDENTIAL_ID=YOUR_CREDENTIAL_ID
CREATORS_CREDENTIAL_SECRET=YOUR_CREDENTIAL_SECRET
CREATORS_CREDENTIAL_VERSION=3.1
CREATORS_PARTNER_TAG=YOUR-TAG
CREATORS_MARKETPLACE=www.amazon.com
